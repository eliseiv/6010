# Service access key (>=32 bytes random). Required.
API_KEY=change-me-32-bytes-random

# OpenAI. Required key; model/budgets optional (ADR-002 defaults).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
CONTEXT_TOKEN_BUDGET=100000
MAX_OUTPUT_TOKENS=2000

# Number of recent thread messages included into context.
HISTORY_MESSAGE_LIMIT=20

# PostgreSQL container settings (used by docker-compose db service).
# Эти три значения — ЕДИНЫЙ источник credentials БД. Меняй пароль ТОЛЬКО здесь.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# PostgreSQL async DSN.
# ВАЖНО: при запуске через docker-compose НЕ задавай DATABASE_URL здесь.
# Compose собирает его сам в секции `environment` сервиса api из POSTGRES_* выше
# (там ${...} реально интерполируются). В env_file (этот файл) интерполяция ${...}
# НЕ выполняется — литерал "${POSTGRES_PASSWORD}" ушёл бы в контейнер дословно и
# привёл бы к asyncpg.InvalidPasswordError / CrashLoop. Единый источник пароля —
# POSTGRES_PASSWORD; меняй его ТОЛЬКО там.
#
# Ручной режим (запуск alembic/приложения ВНЕ docker-compose): раскомментируй
# строку ниже и подставь явный DSN с тем же паролем, что и POSTGRES_PASSWORD.
# Хост 'db' замени на доступный (например localhost), если БД не в compose-сети.
# DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/app

# Logging.
LOG_LEVEL=INFO
