# Secrets — never bake into the image (security: 05-security.md)
.env
.env.*
!.env.example

# VCS
.git
.gitignore
.github

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
