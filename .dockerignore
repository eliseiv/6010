# Tests — not needed in the runtime image
tests/

# Docs — not needed in the runtime image
docs/

# Local tooling / IDE
.venv/
venv/
.vscode/
.idea/
*.md

# Docker artifacts themselves
Dockerfile
docker-compose.yml
docker-compose.override.yml
docker-compose.prod.yml
.dockerignore
